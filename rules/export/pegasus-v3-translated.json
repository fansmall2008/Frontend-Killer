{
  "templateInfo": {
    "version": 3,
    "direction": "export",
    "dataFileType": "text",
    "delimiter": ": ",
    "dataFile": "metadata.pegasus.txt",
    "author": "Frontend-Killer",
    "description": "Pegasus Frontend (Translated) — Same as pegasus-v3 but uses translatedName and translatedDesc / Pegasus 前端（翻译版）— 与 pegasus-v3 相同，但使用 translatedName 和 translatedDesc 替代原始名称和描述 / Pegasus フロントエンド（翻訳版）— pegasus-v3 と同じだが translatedName と translatedDesc を使用",
    "notes": "Identical to pegasus-v3 in structure and output format. Data file: metadata.pegasus.txt in {outputPath}/{platform.system}/. ROM files copied to {outputPath}/{platform.system}/. Media files in {outputPath}/{platform.system}/media/{gameName}/. Key difference: game name uses translatedName (fallback to name) and description uses translatedDesc (fallback to desc). Paths are relative. Supports multi-disc games via files field.\n\n与 pegasus-v3 结构和输出格式完全相同。数据文件：metadata.pegasus.txt 位于 {outputPath}/{platform.system}/。ROM 拷贝到 {outputPath}/{platform.system}/。媒体文件位于 {outputPath}/{platform.system}/media/{gameName}/。核心区别：游戏名使用 translatedName（回退到 name），描述使用 translatedDesc（回退到 desc）。路径为相对路径。支持多盘游戏。\n\npegasus-v3 と同じ構造と出力形式。データファイル：metadata.pegasus.txt は {outputPath}/{platform.system}/ に配置。ROM は {outputPath}/{platform.system}/ にコピー。メディアは {outputPath}/{platform.system}/media/{gameName}/ に配置。主な違い：ゲーム名に translatedName（フォールバック: name）、説明に translatedDesc（フォールバック: desc）を使用。相対パス。マルチディスク対応。"
  },
  "system": {
    "header": [
      "collection: {platform.name}",
      "sort-by: {platform.sortBy}",
      "extensions: {platform.extensions}",
      "ignore-files: {platform.ignoreFiles}",
      "launch: {platform.launch}",
      ""
    ],
    "footer": [
      "# End of file"
    ],
    "fields": {
      "collection": "platform.name",
      "sort-by": "platform.sortBy",
      "extensions": "platform.extensions",
      "ignore-files": "platform.ignoreFiles",
      "launch": "platform.launch"
    }
  },
  "game": {
    "gameStartMarker": "game:",
    "entrySeparator": "\n\n",
    "gameInfo": {
      "game": "coalesce(translatedName, name)",
      "file": "if(multiFile, '', coalesce(romExportPath, path))",
      "files": "multiFileContent",
      "sort-by": "sort-by",
      "developer": "developer",
      "publisher": "publisher",
      "genre": "genre",
      "players": "players",
      "description": "coalesce(translatedDesc, desc)",
      "rating": "rating",
      "release": "releasedate",
      "region": "region"
    },
    "mediaInfo": {
      "assets.boxFront": "box-2D",
      "assets.boxBack": "box-2D-back",
      "assets.boxSpine": "box-2D-side",
      "assets.box3d": "box-3D",
      "assets.cartridge": "support-2D",
      "assets.logo": "wheel-carbon",
      "assets.poster": "flyer",
      "assets.marquee": "marquee",
      "assets.bezel": "bezel-16-9",
      "assets.fanart": "fanart",
      "assets.steam": "steamgrid",
      "assets.background": "background",
      "assets.screenshot": "ss",
      "assets.titlescreen": "sstitle",
      "assets.video": "video"
    }
  },
  "output": {
    "exportOptions": {
      "gameFiles": true,
      "mediaFiles": true,
      "gameListFile": true,
      "showWarning": false
    },
    "roms": {
      "enabled": true,
      "directory": "{outputPath}/{platform.system}",
      "filename": "{filename}{ext}",
      "m3u": {
        "enabled": false,
        "target": "{outputPath}/{platform.system}"
      },
      "cue": {
        "enabled": true,
        "onMissing": "warn"
      }
    },
    "media": {
      "directory": "{outputPath}/{platform.system}/media",
      "rules": {
        "video": {
          "source": "video",
          "target": "{gameName}/video.mp4",
          "dataFileTag": "assets.video"
        },
        "box-2D": {
          "source": "box-2D",
          "target": "{gameName}/boxFront.png",
          "dataFileTag": "assets.boxFront"
        },
        "box-2D-back": {
          "source": "box-2D-back",
          "target": "{gameName}/boxBack.png",
          "dataFileTag": "assets.boxBack"
        },
        "box-3D": {
          "source": "box-3D",
          "target": "{gameName}/box3d.png",
          "dataFileTag": "assets.box3d"
        },
        "ss": {
          "source": "ss",
          "target": "{gameName}/screenshot.png",
          "dataFileTag": "assets.screenshot"
        },
        "marquee": {
          "source": "marquee",
          "target": "{gameName}/marquee.png",
          "dataFileTag": "assets.marquee"
        },
        "fanart": {
          "source": "fanart",
          "target": "{gameName}/fanart.png",
          "dataFileTag": "assets.fanart"
        },
        "bezel-16-9": {
          "source": "bezel-16-9",
          "target": "{gameName}/bezel.png",
          "dataFileTag": "assets.bezel"
        },
        "background": {
          "source": "background",
          "target": "{gameName}/background.png",
          "dataFileTag": "assets.background"
        },
        "box-2D-side": {
          "source": "box-2D-side",
          "target": "{gameName}/boxSpine.png",
          "dataFileTag": "assets.boxSpine"
        },
        "sstitle": {
          "source": "sstitle",
          "target": "{gameName}/titlescreen.png",
          "dataFileTag": "assets.titlescreen"
        },
        "wheel-carbon": {
          "source": "wheel-carbon",
          "target": "{gameName}/logo.png",
          "dataFileTag": "assets.logo"
        },
        "support-2D": {
          "source": "support-2D",
          "target": "{gameName}/cartridge.png",
          "dataFileTag": "assets.cartridge"
        },
        "flyer": {
          "source": "flyer",
          "target": "{gameName}/poster.png",
          "dataFileTag": "assets.poster"
        },
        "steamgrid": {
          "source": "steamgrid",
          "target": "{gameName}/steam.png",
          "dataFileTag": "assets.steam"
        }
      }
    },
    "dataFile": {
      "directory": "{outputPath}/{platform.system}",
      "filename": "metadata.pegasus.txt",
      "pathFormat": "relative",
      "pathPrefix": ""
    }
  }
}
