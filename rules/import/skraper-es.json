{
  "version": 2,
  "frontend": "skraper-es",
  "name": "Skraper-EmulationStation",
  "description": "Skraper 抓取数据导入模板（适用于 EmulationStation 前端，支持深层子目录媒体结构）（v2 — nomcourt 标准）",
  "type": "xml",
  "dataFile": "gamelist.xml",
  "delimiter": "",
  "fieldMappings": {
    "name": ["name"],
    "desc": ["desc", "description"],
    "releasedate": ["releasedate", "release"],
    "developer": ["developer", "dev"],
    "publisher": ["publisher", "pub"],
    "genre": ["genre", "category"],
    "players": ["players", "player"],
    "rating": ["rating"],
    "path": ["path", "file"],
    "hash": ["hash"],
    "lang": ["lang"],
    "gameId": ["id", "gameId"]
  },
  "mediaMappings": {
    "video": ["video"],
    "marquee": ["marquee"],
    "wheel": ["wheel"],
    "ss": ["screenshot"],
    "sstitle": ["titlescreen"],
    "fanart": ["fanart"],
    "box-2D": ["boxFront", "box2dfront"],
    "box-2D-back": ["boxBack", "box2dback"],
    "box-2D-side": ["boxSpine", "box2dside"],
    "box-3D": ["boxFull", "box3d"],
    "box-texture": ["boxtexture"],
    "support-2D": ["cartridge", "support"],
    "support-texture": ["supporttexture"],
    "bezel-16-9": ["bezel"],
    "steamgrid": ["steamgrid"],
    "manuel": ["manual"],
    "background": ["background"],
    "screenmarqueesmall": ["screenmarqueesmall"],
    "figurine": ["figurine"]
  }
}
