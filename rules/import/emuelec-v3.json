{
  "templateInfo": {
    "version": 3,
    "direction": "import",
    "dataFileType": "data",
    "format": "xml",
    "dataFile": "gamelist.xml",
    "author": "Frontend-Killer",
    "description": "EmuELEC 导入模板（v3 统一格式）",
    "notes": "XML 格式，系统信息在 provider 标签内，游戏信息在 game 标签内"
  },
  "system": {
    "systemTag": "provider",
    "fields": {
      "platform.system": ["system"],
      "platform.software": ["software"]
    }
  },
  "game": {
    "gameStartMarker": "game",
    "computedVariables": {
      "filename": "stem(path)",
      "filepath": "replace(path or '', './', '')"
    },
    "gameInfo": {
      "name": ["name"],
      "desc": ["desc", "description"],
      "releasedate": ["releasedate", "release"],
      "developer": ["developer", "dev"],
      "publisher": ["publisher", "pub"],
      "genre": ["genre", "category"],
      "players": ["players", "player"],
      "rating": ["rating"],
      "path": ["path", "file"],
      "hash": ["hash"],
      "lang": ["lang"],
      "gameId": ["id", "gameId"]
    },
    "mediaInfo": {
      "video": ["video"],
      "marquee": ["marquee"],
      "wheel": ["wheel"],
      "ss": ["screenshot"],
      "fanart": ["fanart"],
      "box-2D": ["boxFront", "box2dfront"],
      "box-2D-back": ["boxBack", "box2dback"],
      "box-2D-side": ["boxSpine", "box2dside"],
      "box-3D": ["boxFull", "box3d"],
      "bezel-16-9": ["bezel"],
      "steamgrid": ["steamgrid"],
      "manuel": ["manual"],
      "background": ["background"],
      "sstitle": ["titlescreen"],
      "box-texture": ["boxtexture"],
      "support-texture": ["supporttexture"],
      "support-2D": ["cartridge"]
    }
  }
}
