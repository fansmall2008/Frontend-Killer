{
  "version": 2,
  "frontend": "esde",
  "name": "EmulationStation DE",
  "description": "EmulationStation DE (ES-DE) gamelist.xml 导入模板（v2 — nomcourt 标准）。注意：导入前请将 downloaded_media 和 gamelists 文件夹复制到同一目录。",
  "type": "xml",
  "dataFile": "gamelist.xml",
  "delimiter": "",
  "fieldMappings": {
    "name": ["name"],
    "desc": ["desc", "description"],
    "releasedate": ["releasedate", "release"],
    "developer": ["developer", "dev"],
    "publisher": ["publisher", "pub"],
    "genre": ["genre", "category"],
    "players": ["players", "player"],
    "rating": ["rating"],
    "path": ["path", "file"],
    "hash": ["hash"],
    "lang": ["lang"],
    "gameId": ["id", "gameId"]
  },
  "mediaMappings": {
    "video": ["video"],
    "marquee": ["marquee"],
    "wheel": ["wheel"],
    "ss": ["screenshot"],
    "sstitle": ["thumbnail", "titlescreen"],
    "fanart": ["fanart"],
    "box-2D": ["boxFront", "boxfront"],
    "box-2D-back": ["boxBack", "boxback"],
    "box-3D": ["boxFull", "box3d"],
    "support-2D": ["cartridge", "support-2d"],
    "bezel-16-9": ["bezel"],
    "manuel": ["manual"]
  }
}
