{
  "version": 2,
  "frontend": "lakka",
  "name": "Lakka",
  "description": "Lakka RetroArch 播放列表 (.lpl) 导入模板（v2 — nomcourt 标准）",
  "type": "text",
  "dataFile": "*.lpl",
  "delimiter": "",
  "textFormat": {
    "linesPerEntry": 6,
    "autoDetect": true,
    "supportedLineCounts": [5, 6],
    "lineMappings": {
      "1": "path",
      "2": "name",
      "3": "corePath",
      "4": "coreName",
      "5": "databaseLink",
      "6": "playlistName"
    },
    "nullValueMarker": "DETECT"
  },
  "fieldMappings": {
    "name": ["name"],
    "path": ["path", "files"],
    "corePath": ["corePath"],
    "coreName": ["coreName"],
    "databaseLink": ["databaseLink"],
    "playlistName": ["playlistName"]
  },
  "mediaMappings": {}
}
