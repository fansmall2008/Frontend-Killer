{
  "frontend": "emuelec",
  "name": "EmuELEC",
  "version": "1.0",
  "description": "Template for importing data from EmuELEC frontend. Note: ES checks three locations for gamelist.xml: [SYSTEM_PATH]/gamelist.xml, ~/.emulationstation/gamelists/[SYSTEM_NAME]/gamelist.xml, /etc/emulationstation/gamelists/[SYSTEM_NAME]/gamelist.xml",
  "type": "xml",
  "dataFile": "gamelist.xml",
  "delimiter": "",
  "rules": {
    "header": {
      "enabled": false
    },
    "fieldMappings": {
      "name": {
        "fields": ["name"],
        "isMultiValue": false
      },
      "description": {
        "fields": ["desc", "description"],
        "isMultiValue": false
      },
      "releaseDate": {
        "fields": ["releasedate", "release"],
        "isMultiValue": false
      },
      "developer": {
        "fields": ["developer", "dev"],
        "isMultiValue": false
      },
      "publisher": {
        "fields": ["publisher", "pub"],
        "isMultiValue": false
      },
      "genre": {
        "fields": ["genre", "category"],
        "isMultiValue": false
      },
      "players": {
        "fields": ["players", "player"],
        "isMultiValue": false
      },
      "rating": {
        "fields": ["rating"],
        "isMultiValue": false
      },
      "hash": {
        "fields": ["hash"],
        "isMultiValue": false
      },
      "files": {
        "fields": ["path", "file"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "image": {
        "fields": ["image"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "video": {
        "fields": ["video"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "thumbnail": {
        "fields": ["thumbnail"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "marquee": {
        "fields": ["marquee"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      }
    },
    "media": {
      "box2dfront": {
        "source": "box2dfront",
        "rules": ["downloaded_images/{platform}/box2dfront/{filepath}.{ext}", "media/box2dfront/{filepath}.{ext}", "{platform}/media/box2dfront/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "box2dback": {
        "source": "box2dback",
        "rules": ["downloaded_images/{platform}/box2dback/{filepath}.{ext}", "media/box2dback/{filepath}.{ext}", "{platform}/media/box2dback/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "box2dside": {
        "source": "box2dside",
        "rules": ["downloaded_images/{platform}/box2dside/{filepath}.{ext}", "media/box2dside/{filepath}.{ext}", "{platform}/media/box2dside/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "box3d": {
        "source": "box3d",
        "rules": ["downloaded_images/{platform}/box3d/{filepath}.{ext}", "media/box3d/{filepath}.{ext}", "{platform}/media/box3d/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "fanart": {
        "source": "fanart",
        "rules": ["downloaded_images/{platform}/fanart/{filepath}.{ext}", "media/fanart/{filepath}.{ext}", "{platform}/media/fanart/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "screenshot": {
        "source": "screenshot",
        "rules": ["downloaded_images/{platform}/screenshot/{filepath}.{ext}", "media/screenshot/{filepath}.{ext}", "downloaded_images/{platform}/images/{filepath}.{ext}", "{platform}/media/screenshot/{filepath}.{ext}", "{platform}/media/images/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "video": {
        "source": "video",
        "rules": ["downloaded_images/{platform}/video/{filepath}.{ext}", "downloaded_images/{platform}/videos/{filepath}.{ext}", "media/video/{filepath}.{ext}", "{platform}/media/video/{filepath}.{ext}", "{platform}/media/videos/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "wheel": {
        "source": "wheel",
        "rules": ["downloaded_images/{platform}/wheel/{filepath}.{ext}", "media/wheel/{filepath}.{ext}", "{platform}/media/wheel/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "banner": {
        "source": "banner",
        "rules": ["downloaded_images/{platform}/banner/{filepath}.{ext}", "media/banner/{filepath}.{ext}", "{platform}/media/banner/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "manual": {
        "source": "manual",
        "rules": ["downloaded_images/{platform}/manuals/{filepath}.{ext}", "media/manual/{filepath}.{ext}", "media/manuals/{filepath}.{ext}", "{platform}/media/manuals/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "images": {
        "source": "images",
        "rules": ["downloaded_images/{platform}/images/{filepath}.{ext}", "media/images/{filepath}.{ext}", "{platform}/media/images/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "titlescreen": {
        "source": "titlescreen",
        "rules": ["downloaded_images/{platform}/titlescreen/{filepath}.{ext}", "media/titlescreen/{filepath}.{ext}", "{platform}/media/titlescreen/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "marquee": {
        "source": "marquee",
        "rules": ["downloaded_images/{platform}/marquee/{filepath}.{ext}", "media/marquee/{filepath}.{ext}", "{platform}/media/marquee/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "miximage": {
        "source": "miximage",
        "rules": ["downloaded_images/{platform}/miximage/{filepath}.{ext}", "media/miximage/{filepath}.{ext}", "{platform}/media/miximage/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "cartridge": {
        "source": "cartridge",
        "rules": ["downloaded_images/{platform}/cartridge/{filepath}.{ext}", "media/cartridge/{filepath}.{ext}", "{platform}/media/cartridge/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "bezel": {
        "source": "bezel",
        "rules": ["downloaded_images/{platform}/bezel/{filepath}.{ext}", "media/bezel/{filepath}.{ext}", "{platform}/media/bezel/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      }
    },
    "extensions": {
      "image": ["png", "jpg", "jpeg", "gif", "webp"],
      "video": ["mp4", "mkv", "avi", "wmv", "webm"]
    },
    "gameExtensions": ["chd", "iso", "bin", "cue", "img", "zip", "7z", "rar", "nes", "snes", "md", "gen", "n64", "psx", "ps1", "gba", "nds", "gb", "gbc", "sms", "gg", "pcengine", "pce", "tg16", "saturn", "ps2", "gamecube", "wii", "xbox", "xbox360", "ps3", "ps4", "switch", "3ds", "psp", "ds", "dreamcast", "arcade", "fba", "mame"]
  }
}