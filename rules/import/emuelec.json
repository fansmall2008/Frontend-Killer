{
  "frontend": "emuelec",
  "name": "EmuELEC",
  "version": "1.0",
  "description": "Template for importing data from EmuELEC frontend. PREPARATION REQUIRED: 1) Copy the entire gamelists folder from ~/.emulationstation/ to your import directory. 2) Copy the entire downloaded_images folder from ~/.emulationstation/ to the SAME import directory. Alternatively, you can copy just the specific gamelist.xml file from gamelists/{platform}/ and downloaded_images/{platform}/ folder. EmuELEC uses absolute paths like /home/pi/ROMs/nes/mm2.nes or /storage/roms/nes/mm2.nes. Media files use naming format: {filename}-{mediatype}.{ext} (e.g., Mega Man 2-image.png)",
  "type": "xml",
  "dataFile": "gamelist.xml",
  "delimiter": "",
  "rules": {
    "header": {
      "enabled": false
    },
    "fieldMappings": {
      "name": {
        "fields": ["name"],
        "isMultiValue": false
      },
      "description": {
        "fields": ["desc", "description"],
        "isMultiValue": false
      },
      "releaseDate": {
        "fields": ["releasedate", "release"],
        "isMultiValue": false
      },
      "developer": {
        "fields": ["developer", "dev"],
        "isMultiValue": false
      },
      "publisher": {
        "fields": ["publisher", "pub"],
        "isMultiValue": false
      },
      "genre": {
        "fields": ["genre", "category"],
        "isMultiValue": false
      },
      "players": {
        "fields": ["players", "player"],
        "isMultiValue": false
      },
      "rating": {
        "fields": ["rating"],
        "isMultiValue": false
      },
      "hash": {
        "fields": ["hash"],
        "isMultiValue": false
      },
      "files": {
        "fields": ["path", "file"],
        "isMultiValue": false,
        "transform": {
          "path": "no",
          "replace": {
            "from": "^(/.*/)?([^/]+\\.[^/]+)$",
            "to": "$2"
          }
        }
      },
      "image": {
        "fields": ["image"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "video": {
        "fields": ["video"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "thumbnail": {
        "fields": ["thumbnail"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "marquee": {
        "fields": ["marquee"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      }
    },
    "media": {
      "box2dfront": {
        "source": "box2dfront",
        "rules": ["../../downloaded_images/{platform}/{filepath}-box2dfront.{ext}", "../downloaded_images/{platform}/{filepath}-box2dfront.{ext}", "downloaded_images/{platform}/{filepath}-box2dfront.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "box2dback": {
        "source": "box2dback",
        "rules": ["../../downloaded_images/{platform}/{filepath}-box2dback.{ext}", "../downloaded_images/{platform}/{filepath}-box2dback.{ext}", "downloaded_images/{platform}/{filepath}-box2dback.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "box2dside": {
        "source": "box2dside",
        "rules": ["../../downloaded_images/{platform}/{filepath}-box2dside.{ext}", "../downloaded_images/{platform}/{filepath}-box2dside.{ext}", "downloaded_images/{platform}/{filepath}-box2dside.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "box3d": {
        "source": "box3d",
        "rules": ["../../downloaded_images/{platform}/{filepath}-box3d.{ext}", "../downloaded_images/{platform}/{filepath}-box3d.{ext}", "downloaded_images/{platform}/{filepath}-box3d.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "fanart": {
        "source": "fanart",
        "rules": ["../../downloaded_images/{platform}/{filepath}-fanart.{ext}", "../downloaded_images/{platform}/{filepath}-fanart.{ext}", "downloaded_images/{platform}/{filepath}-fanart.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "screenshot": {
        "source": "screenshot",
        "rules": ["../../downloaded_images/{platform}/{filepath}-image.{ext}", "../../downloaded_images/{platform}/{filepath}-screenshot.{ext}", "../downloaded_images/{platform}/{filepath}-image.{ext}", "../downloaded_images/{platform}/{filepath}-screenshot.{ext}", "downloaded_images/{platform}/{filepath}-image.{ext}", "downloaded_images/{platform}/{filepath}-screenshot.{ext}", "../../downloaded_images/{platform}/{filepath}.{ext}", "../downloaded_images/{platform}/{filepath}.{ext}", "downloaded_images/{platform}/{filepath}.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "video": {
        "source": "video",
        "rules": ["../../downloaded_images/{platform}/{filepath}-video.{ext}", "../downloaded_images/{platform}/{filepath}-video.{ext}", "downloaded_images/{platform}/{filepath}-video.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "wheel": {
        "source": "wheel",
        "rules": ["../../downloaded_images/{platform}/{filepath}-wheel.{ext}", "../downloaded_images/{platform}/{filepath}-wheel.{ext}", "downloaded_images/{platform}/{filepath}-wheel.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "banner": {
        "source": "banner",
        "rules": ["../../downloaded_images/{platform}/{filepath}-banner.{ext}", "../downloaded_images/{platform}/{filepath}-banner.{ext}", "downloaded_images/{platform}/{filepath}-banner.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "manual": {
        "source": "manual",
        "rules": ["../../downloaded_images/{platform}/{filepath}-manual.{ext}", "../downloaded_images/{platform}/{filepath}-manual.{ext}", "downloaded_images/{platform}/{filepath}-manual.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "images": {
        "source": "images",
        "rules": ["../../downloaded_images/{platform}/{filepath}-image.{ext}", "../downloaded_images/{platform}/{filepath}-image.{ext}", "downloaded_images/{platform}/{filepath}-image.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "titlescreen": {
        "source": "titlescreen",
        "rules": ["../../downloaded_images/{platform}/{filepath}-titlescreen.{ext}", "../downloaded_images/{platform}/{filepath}-titlescreen.{ext}", "downloaded_images/{platform}/{filepath}-titlescreen.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "marquee": {
        "source": "marquee",
        "rules": ["../../downloaded_images/{platform}/{filepath}-marquee.{ext}", "../downloaded_images/{platform}/{filepath}-marquee.{ext}", "downloaded_images/{platform}/{filepath}-marquee.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "miximage": {
        "source": "miximage",
        "rules": ["../../downloaded_images/{platform}/{filepath}-miximage.{ext}", "../downloaded_images/{platform}/{filepath}-miximage.{ext}", "downloaded_images/{platform}/{filepath}-miximage.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "cartridge": {
        "source": "cartridge",
        "rules": ["../../downloaded_images/{platform}/{filepath}-cartridge.{ext}", "../downloaded_images/{platform}/{filepath}-cartridge.{ext}", "downloaded_images/{platform}/{filepath}-cartridge.{ext}"],
        "transform": {
          "path": "no"
        }
      },
      "bezel": {
        "source": "bezel",
        "rules": ["../../downloaded_images/{platform}/{filepath}-bezel.{ext}", "../downloaded_images/{platform}/{filepath}-bezel.{ext}", "downloaded_images/{platform}/{filepath}-bezel.{ext}"],
        "transform": {
          "path": "no"
        }
      }
    },
    "extensions": {
      "image": ["png", "jpg", "jpeg", "gif", "webp"],
      "video": ["mp4", "mkv", "avi", "wmv", "webm"]
    },
    "gameExtensions": ["chd", "iso", "bin", "cue", "img", "zip", "7z", "rar", "nes", "snes", "md", "gen", "n64", "psx", "ps1", "gba", "nds", "gb", "gbc", "sms", "gg", "pcengine", "pce", "tg16", "saturn", "ps2", "gamecube", "wii", "xbox", "xbox360", "ps3", "ps4", "switch", "3ds", "psp", "ds", "dreamcast", "arcade", "fba", "mame"]
  }
}
