{
  "version": 2,
  "frontend": "pegasus",
  "name": "Pegasus Frontend",
  "description": "Pegasus metadata.pegasus.txt 导入模板（v2 — nomcourt 标准）",
  "type": "text",
  "dataFile": "metadata.pegasus.txt",
  "delimiter": ":",
  "fieldMappings": {
    "name": ["title", "name", "game"],
    "desc": ["description", "desc"],
    "releasedate": ["release", "releasedate", "date"],
    "developer": ["developer", "dev"],
    "publisher": ["publisher", "pub"],
    "genre": ["genre", "category"],
    "players": ["players", "player"],
    "rating": ["rating"],
    "path": ["files", "file"],
    "lang": ["region"]
  },
  "mediaMappings": {
    "image": ["image", "boxFront"],
    "video": ["video"],
    "thumbnail": ["thumbnail"],
    "marquee": ["marquee"],
    "wheel": ["wheel"],
    "ss": ["screenshot"],
    "fanart": ["fanart"],
    "box-2D": ["boxFront"],
    "box-2D-back": ["boxBack"],
    "box-2D-side": ["boxSpine"],
    "box-3D": ["boxFull", "box3d"],
    "bezel-16-9": ["bezel"],
    "steamgrid": ["steamgrid"],
    "manuel": ["manual"],
    "background": ["background"],
    "sstitle": ["titlescreen"],
    "box-texture": ["boxtexture"],
    "support-texture": ["supporttexture"],
    "logo": ["logo"],
    "poster": ["poster"],
    "panel": ["panel"],
    "banner": ["banner"],
    "support-2D": ["cartridge"]
  }
}
