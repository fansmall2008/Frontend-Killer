{
  "frontend": "retrobat",
  "name": "RetroBat",
  "version": "1.0",
  "description": "Template for Importing Data and Media Files for the Pegasus Frontend.Including All Known Path Types",
  "type": "xml",
  "dataFile": "gamelist.xml",
  "delimiter": "",
  "rules": {
    "header": {
      "enabled": true,
      "format": "xml",
      "startMarker": "<provider>",
      "endMarker": "</provider>",
      "structure": [
        "collection: {platform.name}",
        "sort-by: {platform.sortBy}"
      ],
      "fields": {
        "platform.name": {
          "fields": ["System", "platform"],
          "isMultiValue": false
        },
        "platform.software": {
          "fields": ["software"],
          "isMultiValue": false
        },
        "platform.database": {
          "fields": ["database"],
          "isMultiValue": false
        },
        "platform.web": {
          "fields": ["web"],
          "isMultiValue": false
        },
        "platform.launch": {
          "fields": ["launch"],
          "isMultiValue": false
        },
        "platform.sortBy": {
          "fields": ["sort-by", "sort"],
          "isMultiValue": false
        },
        "platform.description": {
          "fields": ["description", "desc"],
          "isMultiValue": false
        }
      }
    },
    "fieldMappings": {
      "name": {
        "fields": ["name"],
        "isMultiValue": false
      },
      "description": {
        "fields": ["desc", "description"],
        "isMultiValue": false
      },
      "releaseDate": {
        "fields": ["releasedate", "release"],
        "isMultiValue": false
      },
      "developer": {
        "fields": ["developer", "dev"],
        "isMultiValue": false
      },
      "publisher": {
        "fields": ["publisher", "pub"],
        "isMultiValue": false
      },
      "genre": {
        "fields": ["genre", "category"],
        "isMultiValue": false
      },
      "players": {
        "fields": ["players", "player"],
        "isMultiValue": false
      },
      "files": {
        "fields": ["path", "file"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "rating": {
        "fields": ["rating"],
        "isMultiValue": false
      },
      "image": {
        "fields": ["image"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "video": {
        "fields": ["video"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "thumbnail": {
        "fields": ["thumbnail"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "marquee": {
        "fields": ["marquee"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "boxFront": {
        "fields": ["boxFront"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "boxBack": {
        "fields": ["boxBack"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "boxSpine": {
        "fields": ["boxSpine"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "boxFull": {
        "fields": ["boxFull"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "screenshot": {
        "fields": ["screenshot"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "wheel": {
        "fields": ["wheel"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "fanart": {
        "fields": ["fanart"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "logo": {
        "fields": ["logo"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "bezel": {
        "fields": ["bezel"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "panel": {
        "fields": ["panel"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "poster": {
        "fields": ["poster"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "background": {
        "fields": ["background"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      }
    },
    "media": {
      "boxFront": {
        "source": "boxFront",
        "rules": [
          "media/{filename}/boxFront.{ext}",
          "media/{filename}/box_front.{ext}",
          "media/boxFront/{filename}.{ext}",
          "media/box2dfront/{filename}.{ext}",
          "media/images/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "boxBack": {
        "source": "boxBack",
        "rules": [
          "media/{filename}/boxBack.{ext}",
          "media/{filename}/box_back.{ext}",
          "media/boxBack/{filename}.{ext}",
          "media/box2dback/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "boxFull": {
        "source": "boxFull",
        "rules": [
          "media/{filename}/box3d.{ext}",
          "media/{filename}/boxFull.{ext}",
          "media/box3d/{filename}.{ext}",
          "media/boxFull/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "screenshot": {
        "source": "screenshot",
        "rules": [
          "media/{filename}/screenshot.{ext}",
          "media/{filename}/screen.{ext}",
          "media/screenshots/{filename}.{ext}",
          "media/screens/{filename}.{ext}",
          "media/screenshot/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "video": {
        "source": "video",
        "rules": [
          "media/{filename}/video.{ext}",
          "media/{filename}/trailer.{ext}",
          "media/videos/{filename}.{ext}",
          "media/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "wheel": {
        "source": "wheel",
        "rules": [
          "media/{filename}/wheel.{ext}",
          "media/wheel/{filename}.{ext}",
          "media/wheelcarbon/{filename}.{ext}",
          "media/wheelsteel/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "marquee": {
        "source": "marquee",
        "rules": [
          "media/{filename}/marquee.{ext}",
          "media/{filename}/logo.{ext}",
          "media/logos/{filename}.{ext}",
          "media/marquees/{filename}.{ext}",
          "media/screenmarquee/{filename}.{ext}",
          "media/screenmarquesmall/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "fanart": {
        "source": "fanart",
        "rules": [
          "media/{filename}/fanart.{ext}",
          "media/fanart/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "thumbnail": {
        "source": "thumbnail",
        "rules": [
          "media/{filename}/titlescreen.{ext}",
          "media/{filename}/thumbnail.{ext}",
          "media/titlescreen/{filename}.{ext}",
          "media/screentitle/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "boxFull": {
        "source": "boxFull",
        "rules": [
          "media/{filename}/boxFull.{ext}",
          "media/boxFull/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "boxSpine": {
        "source": "boxSpine",
        "rules": [
          "media/{filename}/boxSpine.{ext}",
          "media/{filename}/box_spine.{ext}",
          "media/boxSpine/{filename}.{ext}",
          "media/box_spine/{filename}.{ext}",
          "media/boxspine/{filename}.{ext}",
          "media/box2dside/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "bezel": {
        "source": "bezel",
        "rules": [
          "media/{filename}/bezel.{ext}",
          "media/bezel/{filename}.{ext}",
          "media/bezels/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "panel": {
        "source": "panel",
        "rules": [
          "media/{filename}/panel.{ext}",
          "media/panel/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "poster": {
        "source": "poster",
        "rules": [
          "media/{filename}/poster.{ext}",
          "media/poster/{filename}.{ext}",
          "media/posters/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "background": {
        "source": "background",
        "rules": [
          "media/{filename}/background.{ext}",
          "media/background/{filename}.{ext}",
          "media/bg/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "boxtexture": {
        "source": "boxtexture",
        "rules": [
          "media/{filename}/boxTexture.{ext}",
          "media/boxTexture/{filename}.{ext}",
          "media/boxtexture/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "supporttexture": {
        "source": "supporttexture",
        "rules": [
          "media/{filename}/supportTexture.{ext}",
          "media/supportTexture/{filename}.{ext}",
          "media/supporttexture/{filename}.{ext}",
          "media/support/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      },
      "manual": {
        "source": "manual",
        "rules": [
          "media/{filename}/manual.{ext}",
          "media/manual/{filename}.{ext}",
          "media/manuals/{filename}.{ext}",
          "media/{filename}/manual.pdf"
        ],
        "transform": {
          "path": "no"
        }
      },
      "steamgrid": {
        "source": "steamgrid",
        "rules": [
          "media/{filename}/steamgrid.{ext}",
          "media/steamgrid/{filename}.{ext}",
          "media/grids/{filename}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      }
    },
    "extensions": {
      "image": ["png", "jpg", "jpeg", "gif", "webp"],
      "video": ["mp4", "mkv", "avi", "wmv", "webm"]
    },
    "gameExtensions": ["chd", "iso", "bin", "cue", "img", "zip", "7z", "rar", "nes", "snes", "md", "gen", "n64", "psx", "ps1", "gba", "nds"]
  }
}
