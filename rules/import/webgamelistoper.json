{
  "version": 2,
  "frontend": "webgamelistoper",
  "name": "WebGamelistOper",
  "description": "WebGamelistOper 抓取数据导入模板，用于导入 gamelist.xml 及 WebGamelistOper 抓取的媒体文件（v2 — nomcourt 标准）",
  "type": "xml",
  "dataFile": "gamelist.xml",
  "delimiter": "",
  "fieldMappings": {
    "name": ["name"],
    "desc": ["desc", "description"],
    "releasedate": ["releasedate", "release"],
    "developer": ["developer", "dev"],
    "publisher": ["publisher", "pub"],
    "genre": ["genre", "category"],
    "players": ["players", "player"],
    "rating": ["rating"],
    "path": ["path", "file"],
    "hash": ["hash", "crc", "crc32"],
    "lang": ["lang"],
    "gameId": ["id", "gameId"]
  },
  "mediaMappings": {
    "video": ["video"],
    "video-normalized": ["videonormalized"],
    "marquee": ["marquee"],
    "wheel": ["wheel"],
    "wheel-carbon": ["wheelcarbon"],
    "wheel-steel": ["wheelsteel"],
    "ss": ["screenshot"],
    "sstitle": ["titlescreen"],
    "fanart": ["fanart"],
    "box-2D": ["boxFront", "box-2D"],
    "box-2D-back": ["boxBack", "box-2D-back"],
    "box-2D-side": ["boxside"],
    "box-3D": ["box3d", "box-3D"],
    "box-texture": ["boxtexture"],
    "support-2D": ["cartridge"],
    "support-texture": ["supporttexture"],
    "bezel-16-9": ["bezel"],
    "steamgrid": ["steamgrid", "steam"],
    "manuel": ["manual"],
    "background": ["background"],
    "pictocouleur": ["pictocouleur"],
    "screenmarqueesmall": ["screenmarqueesmall"],
    "figurine": ["figurine"],
    "mixrbv2": ["mixrbv2"]
  }
}
