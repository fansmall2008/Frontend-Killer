# 排除数据库目录，避免旧数据库文件覆盖 volume 中的数据
data/database/
*.db
*.db.*

# 排除刮削缓存（可达数 GB）
data/scraper/

# 排除运行时目录
output/
roms/
backup/
data/work/

# 排除日志目录
logs/
*.log

# 排除临时文件
*.tmp
*.swp
*~

# 排除IDE文件
.idea/
*.iml
.vscode/

# 排除构建产物和发行包
target/
distribution/
wiki-temp/

# 排除截图和临时脚本
screenshot_*.png
maven_*.txt
mvn_*.txt
cp.txt
task_response.json
fix_*.py
merge_*.ps1
build.log
META-INF/
