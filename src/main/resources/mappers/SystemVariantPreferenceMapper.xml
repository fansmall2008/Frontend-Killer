<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gamelist.mapper.SystemVariantPreferenceMapper">

    <resultMap id="SystemVariantPreferenceResultMap" type="com.gamelist.model.SystemVariantPreference">
        <id column="system_id" property="systemId"/>
        <result column="preferred_format" property="preferredFormat"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectBySystemId" resultMap="SystemVariantPreferenceResultMap">
        SELECT * FROM system_variant_preference WHERE system_id = #{systemId}
    </select>

    <select id="selectAll" resultMap="SystemVariantPreferenceResultMap">
        SELECT * FROM system_variant_preference ORDER BY system_id
    </select>

    <insert id="upsert" parameterType="com.gamelist.model.SystemVariantPreference">
        MERGE INTO system_variant_preference
            (system_id, preferred_format, updated_at)
        KEY (system_id)
        VALUES (#{systemId}, #{preferredFormat}, CURRENT_TIMESTAMP)
    </insert>

</mapper>
