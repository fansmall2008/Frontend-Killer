{
  "templateInfo": {
    "version": 3,
    "direction": "export",
    "dataFileType": "data",
    "format": "xml",
    "dataFile": "gamelist.xml",
    "author": "Frontend-Killer",
    "description": "RetroBat gamelist.xml — ROMs copied to platform dir, paths with ./ prefix, includes provider header / RetroBat gamelist.xml — ROM 拷贝到平台目录，路径带 ./ 前缀，含 provider 头 / RetroBat gamelist.xml — ROM をプラットフォームディレクトリにコピー、パスに ./ プレフィックス付き、provider ヘッダー含む",
    "notes": "Data file: gamelist.xml in {outputPath}/{platform.system}/ (same directory as ROMs). ROM files copied to {outputPath}/{platform.system}/. Media files in {outputPath}/{platform.system}/media/{gameName}/. Path format: absoluteWithDot (./ prefix). Includes provider header with system/software/database/web info. Supports M3U chain collection.\n\n数据文件：gamelist.xml 位于 {outputPath}/{platform.system}/（与 ROM 同目录）。ROM 拷贝到 {outputPath}/{platform.system}/。媒体文件位于 {outputPath}/{platform.system}/media/{gameName}/。路径格式：带 ./ 前缀。含 provider 头（system/software/database/web 信息）。支持 M3U 链式收集。\n\nデータファイル：gamelist.xml は {outputPath}/{platform.system}/（ROM と同じディレクトリ）に配置。ROM は {outputPath}/{platform.system}/ にコピー。メディアは {outputPath}/{platform.system}/media/{gameName}/ に配置。パス形式：./ プレフィックス付き。system/software/database/web 情報を含む provider ヘッダー付き。M3U チェーン収集対応。"
  },
  "system": {
    "systemTag": "provider",
    "header": [
      "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
      "<gameList>",
      "  <provider>",
      "    <System>{platform.system}</System>",
      "    <software>{platform.software}</software>",
      "    <database>{platform.database}</database>",
      "    <web>{platform.web}</web>",
      "  </provider>"
    ],
    "footer": [
      "</gameList>"
    ],
    "fields": {
      "system": "platform.system",
      "software": "platform.software",
      "database": "platform.database",
      "web": "platform.web"
    }
  },
  "game": {
    "gameStartMarker": "game",
    "gameInfo": {
      "path": "if(multiFile, m3uPath, coalesce(romExportPath, path))",
      "name": "name",
      "desc": "desc",
      "rating": "rating",
      "releasedate": "releasedate",
      "developer": "developer",
      "publisher": "publisher",
      "genre": "genre",
      "players": "players",
      "region": "lang"
    },
    "mediaInfo": {
      "box2dfront": "box-2D",
      "box2dback": "box-2D-back",
      "box3d": "box-3D",
      "screenshot": "ss",
      "video": "video",
      "wheel": "wheel",
      "marquee": "marquee",
      "fanart": "fanart"
    }
  },
  "output": {
    "exportOptions": {
      "gameFiles": true,
      "mediaFiles": true,
      "gameListFile": true,
      "showWarning": false
    },
    "roms": {
      "enabled": true,
      "directory": "{outputPath}/{platform.system}",
      "filename": "{filename}{ext}",
      "m3u": {
        "enabled": true
      },
      "cue": { "enabled": true, "onMissing": "warn" }
    },
    "media": {
      "directory": "{outputPath}/{platform.system}/media",
      "rules": {
        "box-2D": {
          "source": "box-2D",
          "target": "box2dfront/{gameName}.png",
          "dataFileTag": "box2dfront"
        },
        "box-2D-back": {
          "source": "box-2D-back",
          "target": "box2dback/{gameName}.png",
          "dataFileTag": "box2dback"
        },
        "box-3D": {
          "source": "box-3D",
          "target": "box3d/{gameName}.png",
          "dataFileTag": "box3d"
        },
        "ss": {
          "source": "ss",
          "target": "screenshot/{gameName}.png",
          "dataFileTag": "screenshot"
        },
        "video": {
          "source": "video",
          "target": "video/{gameName}.mp4",
          "dataFileTag": "video"
        },
        "wheel": {
          "source": "wheel",
          "target": "wheel/{gameName}.png",
          "dataFileTag": "wheel"
        },
        "marquee": {
          "source": "marquee",
          "target": "marquee/{gameName}.png",
          "dataFileTag": "marquee"
        },
        "fanart": {
          "source": "fanart",
          "target": "fanart/{gameName}.png",
          "dataFileTag": "fanart"
        }
      }
    },
    "dataFile": {
      "directory": "{outputPath}/{platform.system}",
      "filename": "gamelist.xml",
      "pathFormat": "absoluteWithDot",
      "pathPrefix": ""
    }
  }
}
