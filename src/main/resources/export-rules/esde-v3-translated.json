{
  "templateInfo": {
    "version": 3,
    "direction": "export",
    "dataFileType": "data",
    "format": "xml",
    "dataFile": "gamelist.xml",
    "author": "Frontend-Killer",
    "description": "ES-DE gamelist.xml (Translated) — Same as esde-v3 but uses translatedName and translatedDesc / ES-DE gamelist.xml（翻译版）— 与 esde-v3 相同，但使用 translatedName 和 translatedDesc / ES-DE gamelist.xml（翻訳版）— esde-v3 と同じだが translatedName と translatedDesc を使用",
    "notes": "Identical to esde-v3 in structure and output format. Data file: gamelist.xml in {outputPath}/gamelists/{platform.system}/. ROM files are NOT copied. Media files in {outputPath}/downloaded_media/{platform.system}/. Key difference: game name uses translatedName (fallback to name) and description uses translatedDesc (fallback to desc). Path format: relative (./ prefix). Includes provider tag.\n\n与 esde-v3 结构和输出格式完全相同。数据文件：gamelist.xml 位于 {outputPath}/gamelists/{platform.system}/。不拷贝 ROM 文件。媒体文件位于 {outputPath}/downloaded_media/{platform.system}/。核心区别：游戏名使用 translatedName（回退到 name），描述使用 translatedDesc（回退到 desc）。路径格式：相对路径（./ 前缀）。含 provider 标签。\n\nesde-v3 と同じ構造と出力形式。データファイル：gamelist.xml は {outputPath}/gamelists/{platform.system}/ に配置。ROM はコピーされません。メディアは {outputPath}/downloaded_media/{platform.system}/ に配置。主な違い：ゲーム名に translatedName（フォールバック: name）、説明に translatedDesc（フォールバック: desc）を使用。パス形式：相対パス（./ プレフィックス）。provider タグ対応。"
  },
  "system": {
    "systemTag": "provider",
    "header": [
      "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
      "<gameList>",
      "  <provider>",
      "    <system>{platform.system}</system>",
      "    <software>Frontend-Killer</software>",
      "  </provider>"
    ],
    "footer": [
      "</gameList>"
    ],
    "fields": {
      "system": "platform.system"
    }
  },
  "game": {
    "gameStartMarker": "game",
    "gameInfo": {
      "path": "if(multiFile, m3uPath, path)",
      "name": "coalesce(translatedName, name)",
      "sortname": "sort-by",
      "desc": "coalesce(translatedDesc, desc)",
      "rating": "rating",
      "releasedate": "releasedate",
      "developer": "developer",
      "publisher": "publisher",
      "genre": "genre",
      "players": "players",
      "lang": "lang",
      "region": "region",
      "hash": "hash",
      "genreid": "genreid"
    },
    "mediaInfo": {
      "image": "box-2D",
      "video": "video",
      "marquee": "marquee",
      "fanart": "fanart",
      "screenshot": "ss",
      "titlescreen": "sstitle",
      "wheel": "wheel",
      "boxback": "box-2D-back",
      "box3d": "box-3D",
      "bezel": "bezel-16-9",
      "cartridge": "support-2D",
      "steamgrid": "steamgrid",
      "manual": "manuel"
    }
  },
  "output": {
    "exportOptions": {
      "gameFiles": false,
      "mediaFiles": true,
      "gameListFile": true,
      "showWarning": true
    },
    "roms": {
      "enabled": false,
      "directory": "{outputPath}/roms/{platform.system}",
      "filename": "{filename}{ext}",
      "m3u": {
        "enabled": true
      },
      "cue": { "enabled": true, "onMissing": "warn" }
    },
    "media": {
      "directory": "{outputPath}/downloaded_media/{platform.system}",
      "rules": {
        "box-2D": {
          "source": "box-2D",
          "target": "boxfront/{filename}.png",
          "dataFileTag": "image"
        },
        "box-2D-back": {
          "source": "box-2D-back",
          "target": "boxback/{filename}.png",
          "dataFileTag": "boxback"
        },
        "box-3D": {
          "source": "box-3D",
          "target": "box3d/{filename}.png",
          "dataFileTag": "box3d"
        },
        "sstitle": {
          "source": "sstitle",
          "target": "titlescreen/{filename}.png",
          "dataFileTag": "titlescreen"
        },
        "marquee": {
          "source": "marquee",
          "target": "marquee/{filename}.png",
          "dataFileTag": "marquee"
        },
        "fanart": {
          "source": "fanart",
          "target": "fanart/{filename}.jpg",
          "dataFileTag": "fanart"
        },
        "video": {
          "source": "video",
          "target": "video/{filename}.mp4",
          "dataFileTag": "video"
        },
        "manuel": {
          "source": "manuel",
          "target": "manual/{filename}.pdf",
          "dataFileTag": "manual"
        },
        "wheel": {
          "source": "wheel",
          "target": "wheel/{filename}.png",
          "dataFileTag": "wheel"
        },
        "ss": {
          "source": "ss",
          "target": "screenshot/{filename}.png",
          "dataFileTag": "screenshot"
        },
        "support-2D": {
          "source": "support-2D",
          "target": "support-2d/{filename}.png",
          "dataFileTag": "cartridge"
        },
        "bezel-16-9": {
          "source": "bezel-16-9",
          "target": "bezel/{filename}.png",
          "dataFileTag": "bezel"
        },
        "steamgrid": {
          "source": "steamgrid",
          "target": "steamgrid/{filename}.png",
          "dataFileTag": "steamgrid"
        }
      }
    },
    "dataFile": {
      "directory": "{outputPath}/gamelists/{platform.system}",
      "filename": "gamelist.xml",
      "pathFormat": "relative",
      "pathPrefix": "./"
    }
  }
}
