{
  "templateInfo": {
    "version": 3,
    "direction": "export",
    "dataFileType": "data",
    "format": "xml",
    "dataFile": "gamelist.xml",
    "author": "Frontend-Killer",
    "description": "EmuELEC gamelist.xml — ROMs NOT copied, gamelist.xml inside ROM dir, media in downloaded_images / EmuELEC gamelist.xml — 不拷贝 ROM，gamelist.xml 在 ROM 目录内，媒体在 downloaded_images / EmuELEC gamelist.xml — ROM 未コピー、gamelist.xml は ROM ディレクトリ内、メディアは downloaded_images",
    "notes": "Data file: gamelist.xml in {outputPath}/roms/{platform.system}/ (inside ROM directory). ROM files are NOT copied. Media files in {outputPath}/downloaded_images/{platform.system}/. Path format: absoluteWithDot (./ prefix). Supports M3U chain collection.\n\n数据文件：gamelist.xml 位于 {outputPath}/roms/{platform.system}/（ROM 目录内）。不拷贝 ROM 文件。媒体文件位于 {outputPath}/downloaded_images/{platform.system}/。路径格式：带 ./ 前缀。支持 M3U 链式收集。\n\nデータファイル：gamelist.xml は {outputPath}/roms/{platform.system}/（ROM ディレクトリ内）に配置。ROM ファイルはコピーされません。メディアファイルは {outputPath}/downloaded_images/{platform.system}/ に配置。パス形式：./ プレフィックス付き。M3U チェーン収集対応。"
  },
  "system": {
    "header": [
      "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
      "<gameList>"
    ],
    "footer": [
      "</gameList>"
    ],
    "fields": {}
  },
  "game": {
    "gameStartMarker": "game",
    "gameInfo": {
      "path": "if(multiFile, m3uPath, path)",
      "name": "name",
      "desc": "desc",
      "rating": "rating",
      "releasedate": "releasedate",
      "developer": "developer",
      "publisher": "publisher",
      "genre": "genre",
      "players": "players"
    },
    "mediaInfo": {
      "box2dfront": "box-2D",
      "box2dback": "box-2D-back",
      "box2dside": "box-2D-side",
      "box3d": "box-3D",
      "fanart": "fanart",
      "screenshot": "ss",
      "video": "video",
      "wheel": "wheel",
      "banner": "banner",
      "manual": "manual",
      "images": "image"
    }
  },
  "output": {
    "exportOptions": {
      "gameFiles": false,
      "mediaFiles": true,
      "gameListFile": true,
      "showWarning": true
    },
    "roms": {
      "enabled": false,
      "directory": "{outputPath}/roms/{platform.system}",
      "filename": "{filename}{ext}",
      "m3u": {
        "enabled": true
      },
      "cue": { "enabled": true, "onMissing": "warn" }
    },
    "media": {
      "directory": "{outputPath}/downloaded_images/{platform.system}",
      "rules": {
        "box-2D": {
          "source": "box-2D",
          "target": "box2dfront/{filename}.png",
          "dataFileTag": "box2dfront"
        },
        "box-2D-back": {
          "source": "box-2D-back",
          "target": "box2dback/{filename}.png",
          "dataFileTag": "box2dback"
        },
        "box-2D-side": {
          "source": "box-2D-side",
          "target": "box2dside/{filename}.png",
          "dataFileTag": "box2dside"
        },
        "box-3D": {
          "source": "box-3D",
          "target": "box3d/{filename}.png",
          "dataFileTag": "box3d"
        },
        "fanart": {
          "source": "fanart",
          "target": "fanart/{filename}.png",
          "dataFileTag": "fanart"
        },
        "ss": {
          "source": "ss",
          "target": "screenshot/{filename}.png",
          "dataFileTag": "screenshot"
        },
        "video": {
          "source": "video",
          "target": "video/{filename}.mp4",
          "dataFileTag": "video"
        },
        "wheel": {
          "source": "wheel",
          "target": "wheel/{filename}.png",
          "dataFileTag": "wheel"
        },
        "banner": {
          "source": "banner",
          "target": "banner/{filename}.png",
          "dataFileTag": "banner"
        },
        "manual": {
          "source": "manual",
          "target": "manuals/{filename}.pdf",
          "dataFileTag": "manual"
        },
        "image": {
          "source": "image",
          "target": "images/{filename}.png",
          "dataFileTag": "images"
        }
      }
    },
    "dataFile": {
      "directory": "{outputPath}/roms/{platform.system}",
      "filename": "gamelist.xml",
      "pathFormat": "absoluteWithDot",
      "pathPrefix": ""
    }
  }
}
