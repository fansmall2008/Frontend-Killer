{
  "frontend": "retroid3",
  "name": "Retroid3",
  "version": "1.0",
  "description": "Template for exporting games and screenshots for Retroid3. Simple format with game file path and screenshot.",
  "type": "text",
  "dataFile": "gamelist.txt",
  "delimiter": ",",
  "rules": {
    "textFormat": {
      "linesPerEntry": 2,
      "lineMappings": {
        "1": "files",
        "2": "screenshot"
      }
    },
    "fieldMappings": {
      "files": {
        "fields": ["files"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "screenshot": {
        "fields": ["screenshot"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      }
    },
    "media": {
      "screenshot": {
        "source": "screenshot",
        "rules": [
          "screenshots/{name}.{ext}"
        ],
        "transform": {
          "path": "no"
        }
      }
    },
    "extensions": {
      "image": ["png", "jpg", "jpeg", "gif", "webp"]
    },
    "gameExtensions": ["chd", "iso", "bin", "cue", "img", "zip", "7z", "rar", "nes", "snes", "md", "gen", "n64", "psx", "ps1", "ps2", "gba", "nds", "pce", "sfc", "a26", "a78", "ws", "wsc", "ngp", "ngc", "tg16", "pcd", "fds", "vb", "vboy", "gamecube", "wii", "dreamcast", "saturn", "genesis", "megadrive"]
  }
}