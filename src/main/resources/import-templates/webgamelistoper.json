        "transform": {
          "path": "no"
        }
      },
      "fanart": {
        "source": "fanart",
        "rules": ["data/scraper/games/{platform}/{gameId}/{region}/fanart.png", "scraper/games/{platform}/{gameId}/{region}/fanart.png"],
        "transform": {
          "path": "no"
        }
