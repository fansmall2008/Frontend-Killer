      "boxSpine": {
        "source": "boxSpine",
        "rules": ["data/scraper/games/{platform}/{gameId}/{region}/box-side.png", "scraper/games/{platform}/{gameId}/{region}/box-side.png", "data/scraper/games/{platform}/{gameId}/{region}/boxside.png", "scraper/games/{platform}/{gameId}/{region}/boxside.png"],
