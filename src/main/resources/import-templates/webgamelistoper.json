{
  "frontend": "webgamelistoper",
  "name": "WebGamelistOper",
  "version": "1.0",
  "description": "Template for importing data from WebGamelistOper scraper. Designed to import gamelist.xml data with media files scraped by WebGamelistOper.",
  "type": "xml",
  "dataFile": "gamelist.xml",
  "delimiter": "",
  "rules": {
    "header": {
      "enabled": false
    },
    "fieldMappings": {
      "name": {
        "fields": ["name"],
        "isMultiValue": false
      },
      "description": {
        "fields": ["desc", "description"],
        "isMultiValue": false
      },
      "releaseDate": {
        "fields": ["releasedate", "release"],
        "isMultiValue": false
      },
      "developer": {
        "fields": ["developer", "dev"],
        "isMultiValue": false
      },
      "publisher": {
        "fields": ["publisher", "pub"],
        "isMultiValue": false
      },
      "genre": {
        "fields": ["genre", "category"],
        "isMultiValue": false
      },
      "players": {
        "fields": ["players", "player"],
        "isMultiValue": false
      },
      "rating": {
        "fields": ["rating"],
        "isMultiValue": false
      },
      "hash": {
        "fields": ["hash", "crc", "crc32"],
        "isMultiValue": false
      },
      "files": {
        "fields": ["path", "file"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "image": {
        "fields": ["image"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "video": {
        "fields": ["video"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "thumbnail": {
        "fields": ["thumbnail"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      },
      "marquee": {
        "fields": ["marquee"],
        "isMultiValue": false,
        "transform": {
          "path": "no"
        }
      }
    },
    "media": {
      "image": {
        "source": "image",
        "rules": ["data/scraper/games/{platform}/{gameId}/{region}/image.png", "scraper/games/{platform}/{gameId}/{region}/image.png"],
        "transform": {
          "path": "no"
        }
      },
      "wheel": {
        "source": "wheel",
        "rules": ["data/scraper/games/{platform}/{gameId}/{region}/wheel.png", "scraper/games/{platform}/{gameId}/{region}/wheel.png"],
        "transform": {
          "path": "no"
        }
      },
      "wheelcarbon": {
        "source": "wheelcarbon",
        "rules": ["data/scraper/games/{platform}/{gameId}/{region}/wheelcarbon.png", "scraper/games/{platform}/{gameId}/{region}/wheelcarbon.png"],
        "transform": {
          "path": "no"
        }
      },
      "wheelsteel": {
        "source": "wheelsteel",
        "rules": ["data/scraper/games/{platform}/{gameId}/{region}/wheelsteel.png", "scraper/games/{platform}/{gameId}/{region}/wheelsteel.png"],
        "transform": {
          "path": "no"
        }
      },
      "logo": {
        "source": "logo",
        "rules": ["data/scraper/games/{platform}/{gameId}/{region}/logo.png", "scraper/games/{platform}/{gameId}/{region}/logo.png"],
        "transform": {
          "path": "no"
        }
      },
      "thumbnail": {
        "source": "thumbnail",
        "rules": ["data/scraper/games/{platform}/{gameId}/{region}/thumbnail.png", "scraper/games/{platform}/{gameId}/{region}/thumbnail.png", "data/scraper/games/{platform}/{gameId}/{region}/ss.png", "scraper/games/{platform}/{gameId}/{region}/ss.png"],
        "transform": {
          "path": "no"
        }
      },
      "boxFront": {
        "source": "boxFront",
        "rules": ["data/scraper/games/{platform}/{gameId}/{region}/box-2D.png", "scraper/games/{platform}/{gameId}/{region}/box-2D.png", "data/scraper/games/{platform}/{gameId}/{region}/boxFront.png", "scraper/games/{platform}/{gameId}/{region}/boxFront.png"],
        "transform": {
          "path": "no"
        }
      },
      "boxBack": {
        "source": "boxBack",
        "rules": ["data/scraper/games/{platform}/{gameId}/{region}/box-2D-back.png", "scraper/games/{platform}/{gameId}/{region}/box-2D-back.png", "data/scraper/games/{platform}/{gameId}/{region}/boxBack.png", "scraper/games/{platform}/{gameId}/{region}/boxBack.png"],
        "transform": {
          "path": "no"
