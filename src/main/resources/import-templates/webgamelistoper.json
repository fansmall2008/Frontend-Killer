        "rules": ["data/scraper/games/{platform}/{gameId}/{region}/pictocouleur.png", "scraper/games/{platform}/{gameId}/{region}/pictocouleur.png"],
        "transform": {
          "path": "no"
        }
      },
      "supporttexture": {
        "source": "supporttexture",
        "rules": ["data/scraper/games/{platform}/{gameId}/{region}/supporttexture.png", "scraper/games/{platform}/{gameId}/{region}/supporttexture.png"],
        "transform": {
          "path": "no"
